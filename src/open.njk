<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Me app</title>

  <!-- Simple styles -->
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      flex-direction: column;
      text-align: center;
    }

    img {
      width: 200px;
      height: auto;
      margin-bottom: 20px;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #F1F1F1;
      border-top-color: #3F5290;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>
<body>

  <img src="/assets/images/logo/me_logo.svg" alt="Me app logo" class="light-version-logo">
  <div class="spinner"></div>

  <script>
    const DEEP_LINK_URI = "me.knowyourself.app.me://open";
    const IOS_STORE_URL = "https://apps.apple.com/app/apple-store/id1620948275";
    const ANDROID_STORE_URL = "https://play.google.com/store/apps/details?id=me.knowyourself.app.me";
    const DESKTOP_FALLBACK_URL = "https://www.know-yourself.me";

    function getOS() {
      const userAgent = navigator.userAgent || navigator.vendor || window.opera;
      if (/android/i.test(userAgent)) return 'Android';
      if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) return 'iOS';
      return 'Other';
    }

    function handleRedirect() {
      const os = getOS();
      let fallbackUrl;

      if (os === 'Android') {
        fallbackUrl = ANDROID_STORE_URL;
      } else if (os === 'iOS') {
        fallbackUrl = IOS_STORE_URL;
      } else {
        // Desktop fallback: go straight to the web version
        window.location.replace(DESKTOP_FALLBACK_URL);
        return;
      }

      // Try opening the app
      window.location.href = DEEP_LINK_URI;

      // If it fails, redirect to the store after a short delay
      setTimeout(() => {
        if (document.visibilityState === 'visible') {
          window.location.href = fallbackUrl;
        }
      }, 800);
    }

    document.addEventListener('DOMContentLoaded', handleRedirect);
  </script>
</body>
</html>